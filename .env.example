# ==============================================================================
# Supabase Configuration for Student Registration
# ==============================================================================
# Find these in your Supabase dashboard:
# Project Settings -> API -> Project URL & Project API Keys
# ==============================================================================

# Project URL: The REST & Realtime API endpoint of your Supabase project
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Public Anon Key: The publishable API key for client-side queries protected by RLS
# IMPORTANT: NEVER expose your service_role secret key here!
VITE_SUPABASE_ANON_KEY=your-anon-public-api-key
